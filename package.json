{
  "name": "owly",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '@owly/*' dev",
    "dev:api": "bun run --filter @owly/api dev",
    "dev:web": "bun run --filter @owly/web dev",
    "dev:worker": "bun run --filter @owly/worker dev",
    "build": "bun run --filter '@owly/*' build",
    "test": "bun run --filter '@owly/*' test",
    "test:e2e": "bunx playwright test",
    "db:seed": "bun run --filter @owly/database seed",
    "lint": "bun run --filter '@owly/*' lint",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
