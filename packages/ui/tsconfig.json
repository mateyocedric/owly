{
  "extends": "@owly/config/tsconfig.react.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@owly/ui/components/*": ["./src/components/*"],
      "@owly/ui/lib/*": ["./src/lib/*"],
      "@owly/ui/hooks/*": ["./src/hooks/*"]
    }
