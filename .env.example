# ─── Database (MongoDB) ───────────────────────────────────────────────────────
# Railway MongoDB plugin also exposes MONGO_URL; the API accepts either name.
MONGODB_URI=mongodb://localhost:27017/owly
MONGO_DB=owly
MONGO_PORT=27017

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API Server ───────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
# Railway injects PORT; the API prefers PORT over API_PORT when set.
# Optional comma-separated browser origins if the UI is hosted on another domain.
CORS_ORIGINS=

# ─── Session & Security ──────────────────────────────────────────────────────
# Secret used to sign anonymous session tokens (min 32 characters)
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
# Token expiry in seconds (default: 24 hours)
SESSION_TTL_SECONDS=86400
# Cookie domain (leave empty for localhost)
COOKIE_DOMAIN=

# ─── Admin ────────────────────────────────────────────────────────────────────
# Initial admin credentials (used by seed script)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
# JWT secret for admin authentication
ADMIN_JWT_SECRET=change-me-to-another-random-string-32-chars

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Leave empty in local Vite so /api and /ws use the dev proxy.
# Production builds (Vercel) read apps/web/.env.production.
VITE_API_URL=
VITE_WS_URL=
WEB_PORT=5173
# WebRTC STUN server (default Google public STUN if unset)
VITE_STUN_URL=stun:stun.l.google.com:19302
# Optional TURN (not used yet; add when you need NAT traversal beyond STUN)
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Max messages per minute per session
RATE_LIMIT_MESSAGES_PER_MINUTE=30
# Max connections per IP per hour
RATE_LIMIT_CONNECTIONS_PER_HOUR=20
# Cooldown between "Next" skips in seconds
RATE_LIMIT_SKIP_COOLDOWN_SECONDS=3
# Max reports per session per hour
RATE_LIMIT_REPORTS_PER_HOUR=10

# ─── Matchmaking ─────────────────────────────────────────────────────────────
# Seconds to wait for interest-based match before falling back to random
MATCHMAKING_INTEREST_TIMEOUT_SECONDS=15
# Reconnection grace period in seconds
MATCHMAKING_RECONNECT_GRACE_SECONDS=15

# ─── Moderation ──────────────────────────────────────────────────────────────
# Number of recent messages to capture in a report
MODERATION_REPORT_MESSAGE_COUNT=20
# Retention period for audit logs in days
AUDIT_LOG_RETENTION_DAYS=90
# Retention period for moderation reports in days
REPORT_RETENTION_DAYS=365

# ─── Worker ───────────────────────────────────────────────────────────────────
# Cleanup job interval in seconds
WORKER_CLEANUP_INTERVAL_SECONDS=300
# Session expiry cleanup batch size
WORKER_CLEANUP_BATCH_SIZE=100
